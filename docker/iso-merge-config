#!/usr/bin/env python3
"""iso-merge-config: bring an agent's sandbox config up to date with the dotfiles.

Runs inside the sandbox before each agent launch (bin/iso-agent), on files that
the agent itself also writes (pi's settings.json after /model, codex's
config.toml after /model or a project trust prompt):

    result = defaults  <-  existing file  <-  enforced

- DEFAULTS fill only keys the file does not have yet (the first-run model, pi's
  package list), so a later runtime change survives.
- ENFORCED wins on its own keys on every launch (dotfiles changes reach the
  sandbox); every other key in the file is kept.
- Tables/objects merge key by key, at any depth; any other value (strings,
  numbers, lists) is replaced whole.

The file is rewritten only when the result differs, atomically, keeping its
mode. A TOML rewrite drops the file's comments (the agent's own file; the
documentation stays in the dotfiles). A file that does not parse is an error:
the launch stops rather than overwrite it.

Usage: iso-merge-config json|toml FILE DEFAULTS ENFORCED
"""
import datetime
import json
import os
import re
import sys
import tempfile
import tomllib


def merge(base, over):
    if isinstance(base, dict) and isinstance(over, dict):
        out = dict(base)
        for k, v in over.items():
            out[k] = merge(base[k], v) if k in base else v
        return out
    return over


def load(fmt, path, missing_ok):
    try:
        with open(path, "rb") as f:
            data = f.read()
    except FileNotFoundError:
        if missing_ok:
            return {}
        raise
    if not data.strip():
        return {}
    return json.loads(data) if fmt == "json" else tomllib.loads(data.decode())


# --- a small TOML writer: what tomllib reads back as the same data -----------
BARE = re.compile(r"^[A-Za-z0-9_-]+$")


def tkey(k):
    return k if BARE.match(k) else json.dumps(k)


def tval(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, (datetime.datetime, datetime.date, datetime.time)):
        return v.isoformat()
    if isinstance(v, list):
        return "[" + ", ".join(tval(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{" + ", ".join(f"{tkey(k)} = {tval(x)}" for k, x in v.items()) + "}"
    raise TypeError(f"cannot write {type(v).__name__} as TOML")


def is_aot(v):
    return isinstance(v, list) and v and all(isinstance(x, dict) for x in v)


def emit(table, path, out):
    plain = [(k, v) for k, v in table.items() if not isinstance(v, dict) and not is_aot(v)]
    for k, v in plain:
        out.append(f"{tkey(k)} = {tval(v)}")
    for k, v in table.items():
        sub = path + [tkey(k)]
        if isinstance(v, dict):
            # A table holding only subtables needs no header of its own.
            if not v or any(not isinstance(x, dict) and not is_aot(x) for x in v.values()):
                out.append("")
                out.append("[" + ".".join(sub) + "]")
            emit(v, sub, out)
        elif is_aot(v):
            for item in v:
                out.append("")
                out.append("[[" + ".".join(sub) + "]]")
                emit(item, sub, out)


def dump(fmt, data):
    if fmt == "json":
        return json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    out = []
    emit(data, [], out)
    text = "\n".join(out).lstrip("\n") + "\n"
    if tomllib.loads(text) != data:  # never write what would read back differently
        raise ValueError("TOML round trip changed the data")
    return text


def main():
    if len(sys.argv) != 5 or sys.argv[1] not in ("json", "toml"):
        sys.exit(__doc__.strip().splitlines()[-1])
    fmt, path, defaults_path, enforced_path = sys.argv[1:]
    name = os.path.basename(path)
    try:
        existing = load(fmt, path, missing_ok=True)
        defaults = load(fmt, defaults_path, missing_ok=True)
        enforced = load(fmt, enforced_path, missing_ok=False)
    except (ValueError, OSError) as e:  # JSONDecodeError and TOMLDecodeError are ValueErrors
        sys.exit(f"iso-merge-config: {e}; fix or remove {path}")
    result = merge(merge(defaults, existing), enforced)
    if os.path.exists(path) and result == existing:
        return
    text = dump(fmt, result)
    mode = os.stat(path).st_mode & 0o7777 if os.path.exists(path) else 0o600
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".", prefix=f".{name}.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
    changed = sorted(k for k in set(result) | set(existing) if result.get(k) != existing.get(k))
    print(f"iso-merge-config: {name}: updated {', '.join(changed)}", file=sys.stderr)


if __name__ == "__main__":
    main()

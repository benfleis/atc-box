#!/usr/bin/env bash
# iso-compose — `docker compose` for the sandbox, with the launcher settings
# loaded. Use it for anything you'd otherwise run by hand (build, down, logs):
# plain `docker compose` never reads ~/.config/iso-claude/.env, so it would build
# the image for the wrong ISO_UID, or see different mounts and recreate the
# container under a running session.
set -euo pipefail

COMPOSE_DIR="${ISO_COMPOSE_DIR:-/opt/workspace/config/atc-box/docker}" # where your docker-compose.yaml lives (ISO_COMPOSE_DIR: a worktree, for tests)
source "$COMPOSE_DIR/bin/iso-common.sh"

iso_load_settings
exec docker compose -f "$COMPOSE_DIR/docker-compose.yaml" "$@"
